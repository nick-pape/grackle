# Grackle Docker Compose environment variables.
# Copy this file to .env and uncomment/edit the values you need.

# ── Image ────────────────────────────────────────────────────
# Pin to a specific nightly build for reproducibility, or use "latest".
# GRACKLE_VERSION=latest

# ── Ports ────────────────────────────────────────────────────
# Web UI port on the host (default: 3000).
# GRACKLE_WEB_PORT=3000

# ── GitHub ───────────────────────────────────────────────────
# GitHub CLI token — required for the Codespace adapter and private repos.
# Generate with: gh auth token
# GH_TOKEN=

# ── Knowledge graph ──────────────────────────────────────────
# Neo4j runs embedded by default. Set these to use an external instance:
# GRACKLE_NEO4J_URL=bolt://your-neo4j:7687
# GRACKLE_NEO4J_USER=neo4j
# GRACKLE_NEO4J_PASSWORD=your-password
# GRACKLE_NEO4J_DATABASE=neo4j

# Set to "false" to disable the knowledge graph entirely:
# GRACKLE_KNOWLEDGE_ENABLED=false

# ── TLS / network exposure ───────────────────────────────────
# The Grackle Docker image binds to 0.0.0.0 inside the container and ships
# with `ENV GRACKLE_ALLOW_INSECURE=1` so `docker compose up` works out of
# the box on cleartext http. This is fine on a single machine where the
# port mapping is what gates access, but is NOT appropriate for LAN/WAN
# exposure: the API key and session cookie travel the network in cleartext.
# Remediates GHSA-wcpf-6gwv-47c8.
#
# For production exposure pick one of:
#
# (A) Native TLS — mount a cert + key into the container, then re-arm
#     the startup gate by clearing the image's insecure default:
#       environment:
#         GRACKLE_TLS_CERT: /etc/grackle/cert.pem
#         GRACKLE_TLS_KEY:  /etc/grackle/key.pem
#         GRACKLE_ALLOW_INSECURE: ""
#       volumes:
#         - ./cert.pem:/etc/grackle/cert.pem:ro
#         - ./key.pem:/etc/grackle/key.pem:ro
#
# (B) Fronting TLS proxy (Caddy / nginx / Traefik) — point external
#     traffic at the proxy, then tell Grackle its public origin so OAuth
#     metadata + the Secure cookie reflect https:
#       environment:
#         GRACKLE_PUBLIC_URL: https://grackle.example.com
#         GRACKLE_ALLOW_INSECURE: ""
