# Grackle Environment Variables
# Copy this file to .env and uncomment/edit the values you need.
# See also: deploy/.env.example for Docker Compose-specific variables.

# ── Paths ──────────────────────────────────────────────────────────
# Root data directory for configuration, database, and API keys.
# GRACKLE_HOME=~/.grackle

# ── Server Ports ───────────────────────────────────────────────────
# gRPC server port.
# GRACKLE_PORT=7434

# Web UI + WebSocket server port.
# GRACKLE_WEB_PORT=3000

# MCP server port.
# GRACKLE_MCP_PORT=7435

# ── Public Origin (reverse proxy / TLS) ───────────────────────────
# Canonical browser-facing origin when Grackle runs behind a TLS-terminating
# reverse proxy (e.g. Caddy). When set, it is the source of truth for the
# browser-facing scheme + host: the OAuth authorization-server metadata uses its
# scheme + host, the session cookie gets the Secure flag iff https, HSTS is sent
# iff https, and the pairing/QR URL + channel webhook ingress base URL use it.
# Must be a bare http(s) origin (no path/query/fragment). When unset, behavior is
# unchanged (loopback http defaults), so the casual local user is unaffected.
# Behind a proxy, also set GRACKLE_MCP_ORIGIN (below) so the MCP server's OAuth
# resource/audience matches the public https origin it's reached on.
# GRACKLE_PUBLIC_URL=https://grackle.home

# Explicit browser-facing MCP origin. Used as (1) the trusted asset/CSP origin
# for broker-captured MCP Apps widgets (the widget's <script src> + CSP
# allowlist) and (2) the MCP server's OAuth resource identifier / token audience
# advertised in RFC 9728 protected-resource metadata — so neither depends on the
# spoofable request Host header. Set this for reverse-proxy / TLS deployments
# where the loopback MCP origin isn't browser-reachable. When unset, the broker
# derives it from the bind host + GRACKLE_MCP_PORT and validates the OAuth
# audience against the loopback origin.
# GRACKLE_MCP_ORIGIN=https://mcp.example.com

# MCP Apps widget sandbox port (separate origin for the double-iframe sandbox).
# GRACKLE_SANDBOX_PORT=7436

# Explicit browser-facing MCP Apps sandbox origin. Set this when the web UI is
# served behind a reverse proxy / TLS, where the scheme + port the browser must
# use for the sandbox cannot be inferred from the page origin + GRACKLE_SANDBOX_PORT
# (e.g. SPA over HTTPS but sandbox on plain HTTP). Takes precedence over the port.
# GRACKLE_SANDBOX_ORIGIN=https://sandbox.example.com

# Local PowerLine (agent runtime) port.
# GRACKLE_POWERLINE_PORT=7433

# ── Server Bind Address ───────────────────────────────────────────
# Bind address for the server. Default is localhost only.
# Set to 0.0.0.0 for LAN access (e.g., phone). Use `grackle pair` to
# generate pairing codes for remote clients.
# GRACKLE_HOST=127.0.0.1

# ── TLS (native, no fronting proxy) ───────────────────────────────
# When both GRACKLE_TLS_CERT and GRACKLE_TLS_KEY are set, all four
# Grackle listeners (web, sandbox, MCP, gRPC) terminate TLS in-process.
# The web/sandbox/MCP listeners use http2.createSecureServer with
# `allowHTTP1: true` so HTTP/1.1 clients still negotiate. The gRPC
# listener is intentionally h2-only (no HTTP/1.1 fallback): gRPC clients
# always speak h2. Required for --allow-network deployments without a
# TLS-terminating reverse proxy (Caddy, nginx). When unset, listeners
# serve cleartext (loopback-only safe). Remediates GHSA-wcpf-6gwv-47c8.
#
# Generate a localhost self-signed cert for testing:
#   openssl req -x509 -newkey rsa:2048 -nodes -days 30 \
#     -subj "/CN=localhost" -keyout key.pem -out cert.pem
#
# For LAN access use a cert covering the IPs/names you advertise
# (mkcert is a fast option for internal use).
# GRACKLE_TLS_CERT=/etc/grackle/cert.pem
# GRACKLE_TLS_KEY=/etc/grackle/key.pem
# Optional intermediate-CA chain bundle. Appended to the leaf cert at
# load time so the full chain is served to clients. This is SERVER identity
# only (chain serving). For client-cert verification (mTLS) see #1393 — a
# separate GRACKLE_TLS_CLIENT_CA env var is planned there.
# GRACKLE_TLS_CHAIN=/etc/grackle/chain.pem

# ── Client Connection ─────────────────────────────────────────────
# gRPC server URL used by the CLI and MCP clients.
# GRACKLE_URL=http://127.0.0.1:7434

# API key for authenticating with the server.
# Generated automatically on first run; override for scripted setups.
# GRACKLE_API_KEY=

# ── Server Behavior ───────────────────────────────────────────────
# Set to "1" to skip auto-starting the local PowerLine server.
# Useful when running PowerLine separately or on a remote host.
# GRACKLE_SKIP_LOCAL_POWERLINE=

# Set to "1" to disable the scheduling plugin (schedule CRUD + cron phase).
# When set, the server runs without schedule support.
# GRACKLE_SKIP_SCHEDULING=

# Set to "1" to disable the orchestration plugin (tasks, personas,
# escalations). When set, the server runs in core-only mode (sessions + environments).
# GRACKLE_SKIP_ORCHESTRATION=

# Directory containing the compiled web UI assets.
# GRACKLE_WEB_DIR=

# ── Encryption ─────────────────────────────────────────────────────
# Encryption key for token storage. If unset, generated and saved to
# $GRACKLE_HOME/master-key on first run.
# GRACKLE_MASTER_KEY=

# ── PowerLine ──────────────────────────────────────────────────────
# Authentication token for the PowerLine server.
# GRACKLE_POWERLINE_TOKEN=

# ── MCP Configuration ─────────────────────────────────────────────
# Path to MCP servers config JSON file (read by runtimes for tool
# registration).
# GRACKLE_MCP_CONFIG=

# ── Docker Adapter ─────────────────────────────────────────────────
# Docker network name for Docker-outside-of-Docker (DooD) setups.
# When set, containers reach the server via network name instead of
# host port mapping.
# GRACKLE_DOCKER_NETWORK=

# DooD host address. When set, wildcard bind addresses (0.0.0.0, ::)
# resolve to this value so containers can reach the server.
# GRACKLE_DOCKER_HOST=

# Image used for the connectivity sidecar in Docker attach mode, started when
# the host cannot reach an attached container directly. Defaults to alpine/socat.
# GRACKLE_DOCKER_SOCAT_IMAGE=

# ── Knowledge Graph (Neo4j) ───────────────────────────────────────
# Set GRACKLE_KNOWLEDGE_ENABLED=true to load the knowledge plugin.
# Loading the plugin is the opt-in — it connects to Neo4j, creates the
# embedder, registers gRPC handlers, and exposes knowledge MCP tools.
# GRACKLE_KNOWLEDGE_ENABLED=false

# Neo4j connection settings (only used when knowledge graph is enabled).
# GRACKLE_NEO4J_URL=bolt://127.0.0.1:7687
# GRACKLE_NEO4J_USER=neo4j
# GRACKLE_NEO4J_PASSWORD=grackle-dev
# GRACKLE_NEO4J_DATABASE=neo4j

# Retrieval loop (#1259): at session spawn, a "Related prior work" block is
# searched from the graph and injected into the agent's prompt (per-task
# injectKnowledge flag, default on). All knobs are optional; defaults are
# conservative (prefer no block over marginal matches).
# GRACKLE_KG_RELATED_MIN_SCORE=0.35      # cosine similarity floor (0-1)
# GRACKLE_KG_RELATED_LIMIT=5             # max search hits considered
# GRACKLE_KG_RELATED_MAX_ITEMS=6         # max items rendered
# GRACKLE_KG_RELATED_MAX_CHARS=2000      # total char budget for the block
# GRACKLE_KG_RELATED_PER_ITEM_CHARS=300  # per-item content snippet cap
# GRACKLE_KG_RELATED_EXPAND=true         # 1-hop expand from the top hit
# GRACKLE_KG_RELATED_EXPAND_TOPK=1
# GRACKLE_KG_RELATED_EXPAND_DEPTH=1
# GRACKLE_KG_SPAWN_CONTEXT_TIMEOUT_MS=1500  # per-provider spawn-context timeout

# ── Concurrency ──────────────────────────────────────────────────
# Reconciliation tick interval in milliseconds (default: 10000).
# GRACKLE_RECONCILIATION_TICK_MS=10000

# ── Logging ────────────────────────────────────────────────────────
# Pino log level: debug, info, warn, error, fatal.
# LOG_LEVEL=info

# Node environment. When not "production", logs are pretty-printed.
# NODE_ENV=

# OpenTelemetry OTLP endpoint for the additive runtime-diagnostics logs sink
# (AHP HR7). When set, runtime lifecycle/diagnostic events are additionally
# exported as OTLP log records over HTTP (e.g. http://localhost:4318). The
# logs-specific OTEL_EXPORTER_OTLP_LOGS_ENDPOINT takes precedence if both are
# set. Unset = disabled (the default); diagnostics still flow to the
# JSONL/stream/session log regardless.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=

# ── Web UI (Vite build-time) ──────────────────────────────────────
# Base URL path for subpath deployments (e.g., /grackle/).
# VITE_BASE_URL=/

# Enable demo mode in the web UI (compiled in at build time).
# VITE_DEMO_MODE=false

# ── Testing (Playwright E2E) ──────────────────────────────────────
# Number of parallel Playwright workers per shard. Defaults to 2 in CI, else
# min(4, cpuCount/2). Accepts an integer or a percentage (e.g. "50%").
# E2E_WORKERS=

# Collect V8 code coverage during the E2E run. When "true", each test's
# coverage is source-mapped back to packages/web/src and written to
# tests/e2e-tests/coverage/lcov.info for the combined-coverage merge.
# Off by default so local TDD runs stay fast. Requires the web bundle to be
# built with source maps (always emitted; see packages/web/vite.config.ts).
# E2E_COVERAGE=false

# ── Third-Party Providers ─────────────────────────────────────────
# OpenAI API key for the Codex runtime.
# OPENAI_API_KEY=

# Override for OpenAI API key (explicit Codex runtime configuration).
# CODEX_API_KEY=

# Custom OpenAI API base URL (for proxies or alternative providers).
# OPENAI_BASE_URL=

# GitHub CLI token (used by Codespace adapter and private repos).
# Generate with: gh auth token
# Serves as the fallback when no GitHub accounts are registered in the database.
# GH_TOKEN=

# Alternative GitHub token env var (also used as fallback, lower priority than GH_TOKEN).
# GITHUB_TOKEN=
